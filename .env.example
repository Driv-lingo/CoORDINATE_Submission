# CoORDINATE configuration
# Copy to .env.local for local development. EVERY setting is optional:
# without them the app runs fully on local fallbacks (rules interpreter,
# in-memory store, OpenStreetMap tiles, polling).

# --- Azure AI Foundry (intake interpretation, briefings, SITREPs) ----------
# Resource endpoint, e.g. https://<resource>.openai.azure.com
#                   or https://<resource>.services.ai.azure.com
# (a Foundry project endpoint .../api/projects/<name> also works)
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
# The *deployment* name of your chat model (e.g. gpt-4.1-mini)
AZURE_AI_FOUNDRY_DEPLOYMENT=
# Optional: set to use the legacy /openai/deployments/{name}?api-version=... route
# instead of the v1 API (e.g. 2024-10-21)
AZURE_AI_FOUNDRY_API_VERSION=
# Optional: the model accepts images — resident photos at intake and on-request
# classification of live public camera frames (never acted on alone)
AZURE_AI_FOUNDRY_VISION=false
AZURE_AI_FOUNDRY_TIMEOUT_MS=15000

# --- Azure Cosmos DB (NoSQL API) ------------------------------------------
# Database and containers (incidents, missions, responders, ops; partition
# key /workspaceId) are created automatically on first use.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=coordinate

# --- Azure Maps -------------------------------------------------------------
# Used server-side only (tiles, geocoding, traffic incidents, traffic-aware
# routing with avoid-areas); never sent to the browser.
AZURE_MAPS_KEY=
# Traffic Incident API version: 1.0 (default, tm.poi format) or a newer
# GeoJSON version supported by your account
AZURE_MAPS_TRAFFIC_API_VERSION=1.0

# --- Live Virginia sources (read-only; all optional) ------------------------
# National Weather Service (api.weather.gov) needs no key, only a User-Agent
# that identifies you. Set NWS_ENABLED=false to disable.
NWS_USER_AGENT=
NWS_AREA=VA
NWS_ENABLED=true
# Virginia 511 / VDOT via SmarterRoads (free registration). Event feed as
# GeoJSON or WZDx v4; the token is appended as ?token= unless
# VA511_TOKEN_HEADER names a header to send it in.
VA511_FEED_URL=
VA511_API_TOKEN=
VA511_TOKEN_HEADER=
VDOT_CAMERA_FEED_URL=
# A locality's published active-calls feed, only where its terms permit reuse.
# Treated as delayed awareness; never directs volunteers.
PUBLIC_CAD_FEED_URL=
PUBLIC_CAD_SOURCE_NAME=
PUBLIC_CAD_DELAY_SECONDS=600
# Comma-separated local news RSS feeds (unverified media; never acted on alone)
NEWS_RSS_URLS=
# Authorized IPAWS CAP 1.2 feed (requires FEMA IPAWS-OPEN authorization)
IPAWS_CAP_FEED_URL=
# Operation area for traffic/camera/CAD filtering: minLng,minLat,maxLng,maxLat
COORDINATE_OPERATION_BBOX=-80.25,37.1,-79.75,37.45

# --- Azure Web PubSub (optional live updates) ------------------------------
AZURE_WEB_PUBSUB_CONNECTION_STRING=
AZURE_WEB_PUBSUB_HUB=coordinate

# --- Behaviour --------------------------------------------------------------
# Routes decide the workspace: /demo/* is each browser's private copy of the
# simulated exercise; every other page is the one shared live operation.
# Private preview: when set, every page and API asks for this password
# (browser sign-in box; any user name). Leave empty for a public site.
COORDINATE_ACCESS_PASSWORD=
# Live operation sign-in (prototype; production would use Entra ID): cookies are
# HMAC-signed with this secret (e.g. `openssl rand -hex 32`). Without it, a random
# per-process key is used and everyone is signed out on restart.
COORDINATE_SESSION_SECRET=
# Passcode required to act as coordinator in the live operation (set it!).
# Empty = anyone who can open the site can act as coordinator.
COORDINATE_COORDINATOR_PASSCODE=
# Data mode is chosen by route, not by a setting: /demo (and every other page) runs
# the simulated exercise; /live shows the real Virginia sources above.
# Live ingest: polled server-side at start-up (set false to poll only when /live is read).
COORDINATE_LIVE_INGEST=true
COORDINATE_OPERATION_NAME=TS Delphine — Roanoke Valley
# Dollar value used to express donated volunteer hours on the dashboard
COORDINATE_VOLUNTEER_HOUR_VALUE=34.79
# Force every adapter to its local fallback (useful for offline demos/tests)
COORDINATE_FORCE_LOCAL=false
